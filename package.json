{
  "name": "kilo-models",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:detail-errors": "playwright test -c playwright.detail-errors.config.ts",
    "test:e2e:native": "bun run build && node scripts/test-native.mjs",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:a11y": "playwright test --grep=accessibility",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/recharts": "^2.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
